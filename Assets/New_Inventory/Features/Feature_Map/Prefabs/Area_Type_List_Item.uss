.area-type-list-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  height: 24px;
  max-height: 24px;
}

#area-type-icon {
  width: 12px;
  height: 12px;
  max-height: 12px;
  border-radius: 50%;
  background-color: #d4a017;
}

#area-type-icon.boss {
  background-color: rgba(212, 23, 23, 0.4);
}

#area-type-text {
  font-size: 12px;
  letter-spacing: 24px;
  color: #c8a84e;
}
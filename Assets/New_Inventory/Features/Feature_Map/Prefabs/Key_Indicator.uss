#key-indicator {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 4px;
  border-radius: 6px;
  border-width: 1px;
  border-color: rgba(139, 105, 20, 0.5);
  opacity: 0.6;
  background-color: #2a2218;
  margin-right: 8px;
}

#key-indicator-text {
  font-size: 16px;
  color: #fff;
}

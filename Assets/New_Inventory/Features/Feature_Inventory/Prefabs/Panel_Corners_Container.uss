#panel-corners-container{
  position: absolute;
  width: 100%;
  height: 100%;
  max-width: 100%;
  max-height: 100%;
}

.panel-corners{
  position: absolute;
  width: 10px;
  height: 10px;
  background-color: #79716B;
  opacity: 40%;
  border-radius: 50%;
}

.panel-corners.top-left{
  top: 10px;
  left: 10px;
}

.panel-corners.top-right{
  top: 10px;
  right: 10px;
}

.panel-corners.bottom-left{
  bottom: 10px;
  left: 10px;
}

.panel-corners.bottom-right{
  bottom: 10px;
  right: 10px;
}
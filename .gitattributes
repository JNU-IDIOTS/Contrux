# Git이 자동으로 텍스트 파일과 바이너리 파일을 구별하도록 합니다.
* text=auto

# 아래 파일들은 텍스트 파일임에도 불구하고 Git이 바이너리로
# 오해할 수 있으므로, 강제로 텍스트(text)로 지정합니다.
# (줄바꿈 처리가 적용됩니다.)
*.cs text
*.shader text
*.cginc text
*.compute text

# 아래 파일들은 바이너리(binary) 파일입니다.
# Git이 이 파일들의 줄바꿈을 절대 건드리지 않도록(변환하지 않도록) 설정합니다.
# (이걸 안 하면 파일이 깨질 수 있습니다.)
*.unity binary
*.prefab binary
*.mat binary
*.asset binary
*.meta binary
*.anim binary
*.controller binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tga binary
*.tif binary
*.psd binary
*.fbx binary
*.obj binary
*.max binary
*.blend binary
*.mp3 binary
*.wav binary
*.ogg binary
*.dll binary
*.so binary
*.bundle binary
*.a binary